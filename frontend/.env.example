# ========================
# Frontend - Biến Môi Trường
# ========================
# Tất cả biến phải bắt đầu bằng VITE_ để Vite inject vào client

# URL API Backend (dùng cho Axios baseURL)
VITE_API_URL=http://localhost:5001/api/v1

# URL Socket.IO Backend (dùng cho kết nối real-time)
VITE_SOCKET_URL=http://localhost:5001

# Mã máy (định danh máy bán hàng, dùng khi chạy kiểu kiosk)
VITE_MACHINE_ID=VM001

# Khoảng thời gian tự động refresh (mili giây)
VITE_REFRESH_INTERVAL=30000

# Thời gian chờ thanh toán tối đa (giây)
VITE_PAYMENT_TIMEOUT=300
