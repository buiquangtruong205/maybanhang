# ============================================
# PayOS Integration
# Replace these placeholders with real credentials in `infra/.env`.
# Backend startup now fails fast if these values are left unchanged.
# ============================================
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here

# ============================================
# Database (PostgreSQL) - Docker internal
# ============================================
DATABASE_URL=postgresql://postgres:123456@db:5432/vending_machine

# ============================================
# JWT / Authentication
# ============================================
SECRET_KEY=change_this_to_a_random_secret_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# Security (CORS)
# ============================================
CORS_ORIGINS=*

# ============================================
# Server
# ============================================
DOMAIN=http://localhost:5000
PORT=5000
PUBLIC_MQTT_BROKER=
PUBLIC_MQTT_PORT=1883

# ============================================
# IoT Security
# ============================================
TIMESTAMP_TOLERANCE=30
NONCE_TTL=120
IOT_SECURITY_LOG_LEVEL=WARNING
